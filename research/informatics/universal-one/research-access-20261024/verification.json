      "path": "/research",
      "status": 200,
      "question": "Which studies in our Sound collection report gene-expression changes after recreational music making? Give a brief answer with sources.",
      "context": {
        "page": "/informatics/",
        "area": "sound",
        "atlas": {
          "record": "fibonacci-m9-p24",
          "view": ""
        },
        "library": {
